{
  "name": "song2html",
  "version": "2026.9.14",
  "description": "Convert chord-lyric source text-files to formatted HTML for rendering song charts",
  "main": "index.js",
  "type": "module",
  "bin": {
    "song2html-mcp": "bin/song2html-mcp.js",
    "song2html-claude": "bin/song2html-claude.js",
    "song2html-tool": "bin/song2html-tool.js"
  },
  "scripts": {
    "test": "node test/runner.js && node --test test/ast.test.js test/mcp.integration.test.js test/plugin-host.test.js test/plugin-tool.test.js && python3 -m unittest discover -s test -p 'test_hermes*.py'",
    "test:mcp": "node --test test/mcp.integration.test.js",
    "fixtures:update": "SONG2HTML_UPDATE_FIXTURES=1 node test/runner.js",
    "start:mcp": "node bin/song2html-mcp.js"
  },
  "files": [
    "index.js",
    "AST.md",
    "SPEC.md",
    "bin/",
    "src/",
    "commands/",
    "plugin.json",
    "plugin.yaml",
    "__init__.py",
    "after-install.md",
    ".claude-plugin/",
    ".mcp.json",
    "mcp-servers.json",
    "skills/"
  ],
  "keywords": [
    "song",
    "chord",
    "lyrics",
    "html",
    "music",
    "nashville-number",
    "claude-code-plugin",
    "grok",
    "grok-build",
    "hermes",
    "mcp"
  ],
  "author": "fingerskier",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  }
}
